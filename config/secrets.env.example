# Copy to secrets.env and fill in. NEVER commit the real secrets.env file.

# ---------------------------------------------------------------------------
# ONE Cloud API key is enough for everything this POC does.
#
# Create it under a SERVICE ACCOUNT (not your user), choosing "Cloud resource
# management" as the scope (NOT a Kafka-cluster-scoped key — those fail
# against the Metrics API). Grant that service account these roles:
#   - MetricsViewer   -> Metrics API + Service Quotas API
#   - BillingAdmin    -> Costs API   (OrganizationAdmin also works)
#   - read access to environments / clusters / connectors / Flink pools
#     (OrganizationAdmin covers all of the above in a single role)
#
# Simplest: OrganizationAdmin + MetricsViewer on the service account. Grant
# MetricsViewer explicitly even with OrganizationAdmin — the Metrics API
# authorizes specifically off that role.
# ---------------------------------------------------------------------------
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# OPTIONAL: only set these if you want a SEPARATE least-privilege key for the
# Metrics/Quotas APIs (e.g. a metrics-only service account with just
# MetricsViewer). If left blank, the Cloud key above is used for metrics too.
CONFLUENT_METRICS_API_KEY=
CONFLUENT_METRICS_API_SECRET=

# Your Confluent Cloud organization id (find in Console > Administration >
# Billing and payment > Payment details and contacts).
CONFLUENT_ORG_ID=

# Monthly budget in USD for the billing threshold + forecast alerts. Overrides
# the default in config/config.yaml — change it here instead of editing config.
MONTHLY_BUDGET_USD=1000

# Dashboard data source. By default the dashboard loads the last 6 months of
# spend automatically (fetching any uncached months once, then serving from the
# local cache — the auto-refresh timer never re-fetches the trend). Set to 1 to
# make the dashboard read ONLY the local DB and never call Confluent on its own
# (populate it with `python -m dashboard.sync` or the scheduler; use the per-
# month Sync button to pull individual months).
DASHBOARD_DB_ONLY=0

# Postgres connection string. Omit / leave blank to fall back to a local
# SQLite file (./data/alerts.db) for dev/POC use.
DATABASE_URL=

# --- Notifiers ---
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
